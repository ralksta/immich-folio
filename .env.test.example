# Required in production. Generate a private value with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-random-secret

# Optional: CARTO Voyager is selected only when this key is set.
# It is embedded in the browser bundle, so treat it as public and rebuild after
# changing it. Without a key, maps use OpenStreetMap.
# NEXT_PUBLIC_CARTO_API_KEY=

# IMMICH_API_URL and IMMICH_API_KEY can be omitted when entering credentials
# through the first-run setup page; add them here to configure the test instance
# from the environment instead.
# IMMICH_API_URL=http://your-immich-server:2283
# IMMICH_API_KEY=your-immich-api-key
